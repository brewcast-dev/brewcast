# AI Models
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=

# AI cost tracking (lib/ai/usage.ts — logs every LLM call to the ai_usage table)
# All optional; sensible defaults shown. Gemini is the only spend that counts
# toward the prepaid budget (Groq/Mistral run on separate accounts).
USD_INR_RATE=85            # forex used to convert token cost to rupees
AI_BUDGET_INR=1000         # your prepaid deposit — drives the warn/over status
AI_BUDGET_WARN_PCT=0.8     # warn once Gemini spend crosses this fraction of the budget
AI_BUDGET_SINCE=           # ISO date the deposit was loaded (e.g. 2026-06-05). Blank = all-time.

# Hugging Face (TTS + Music)
HUGGING_FACE_TOKEN=

# Image Generation
PIXAZO_API_KEY=

# Claid.ai (AI image enhancement — non-generative HDR/color/sharpen)
# Sign up at https://app.claid.ai/ — trial gives ~100 free credits.
# Used by /debug/compare for A/B testing against Nano Banana.
CLAID_API_KEY=

# Cloudflare Workers AI (free img2img fallback when Nano Banana is quota-blocked)
# Sign up: https://dash.cloudflare.com/sign-up/workers-ai
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase DB direct connection (for pg-boss)
# Found at: Supabase dashboard → Settings → Database → Connection string (URI)
SUPABASE_DB_URL=

# Meta / Instagram / Facebook
META_APP_ID=
META_APP_SECRET=
META_IG_APP_ID=
META_IG_APP_SECRET=
META_IG_USER_ID=
META_ACCESS_TOKEN=
META_FB_PAGE_ID=

# App
NEXT_PUBLIC_APP_URL=

# Queue security (random string — add to GitHub Actions secrets too)
QUEUE_SECRET=
